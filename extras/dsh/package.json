{
  "name": "dsh-krouter",
  "version": "0.3.1",
  "description": "KRouter Obsidian — DSH Plugin: Agent Second Brain. Obsidian knowledge base and memory system. Optional self-evolution. Also mounts on Cursor and Codex. No vector store.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./route": {
      "default": "./lib/route.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "krouter",
    "knowledge-base",
    "memory-system",
    "second-brain",
    "self-evolution",
    "agent-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
